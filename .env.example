# 复制为 .env 后按需修改；环境变量优先于文件。默认离线运行。
LLM_PROVIDER=fake
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
EXTRACTION_MODEL=deepseek-flash
ANALYSIS_MODEL=deepseek-flash
EXTRACTION_THINKING=disabled
ANALYSIS_THINKING=disabled
LLM_TIMEOUT_SECONDS=60
# 最多重试两次，即一个任务最多发起三次请求。
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_SECONDS=0.5
LLM_MAX_OUTPUT_TOKENS=1024
LLM_USAGE_LOG=data/llm_calls.jsonl
DATABASE_PATH=data/easy_writing.db
# 默认在小说知识库旁创建 easy_writing_chat.db；可在此指定独立文件。
# CHAT_DATABASE_PATH=data/easy_writing_chat.db
# 本地 PDF OCR 可选。配置目录中需有语言对应的 .traineddata 文件。
# OCR_TESSDATA_PATH=.cache/tessdata
# OCR_LANGUAGE=chi_sim+eng
EMBEDDING_BACKEND=bge
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_CACHE=.cache/models
RETRIEVAL_LOG=data/retrieval_calls.jsonl
